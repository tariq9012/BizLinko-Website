# Supabase — server-side (used by server functions, SSR, and cron auth)
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Supabase — service role key, server-side only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# Supabase — client-side (exposed to the browser via Vite's VITE_ prefix)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Cron endpoint authentication (only needed if src/integrations/supabase/cron-auth.ts is wired up to a route)
CRON_SECRET="a-long-random-secret"
CRON_SECRET_PREVIOUS="previous-secret-during-rotation"
